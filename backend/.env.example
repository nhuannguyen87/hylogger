# Copied to backend/.env by ./setup.sh. Read by app/database.py and
# app/media_reader.py; backend/README.md, "Configuration", explains each value.

# Local ETL4 handoff: read-only Postgres + the asset files on disk
ETL4_READ_DSN=host=localhost port=5432 dbname=etl4_core user=etl4_reader password=CHANGE_ME sslmode=disable
ETL4_DB_AUTH=password
ETL4_ASSET_BACKEND=local
ETL4_ROOT=/absolute/path/to/etl4

# AWS Aurora + S3 instead (temporary AWS credentials, IAM database auth;
# also pip install -r requirements-aws.txt):
# ETL4_READ_DSN=host=YOUR_AURORA_HOST port=5432 dbname=etl4_core user=etl4_reader
# ETL4_DB_AUTH=iam
# ETL4_AWS_REGION=ap-southeast-2
# ETL4_ASSET_BACKEND=s3
# ETL4_S3_BUCKET=YOUR_BUCKET
# ETL4_S3_PREFIX=etl4/releases/YOUR_RELEASE_ID
# ETL4_S3_ROOT_KEY=etl4_s3_primary
