# Local read-only PostgreSQL and asset files
ETL4_READ_DSN=host=127.0.0.1 port=5432 dbname=etl4_core user=etl4_reader password=CHANGE_ME
ETL4_DB_AUTH=password
ETL4_ASSET_BACKEND=local
ETL4_ROOT=/absolute/path/to/etl4
ETL4_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AWS: use the execution role; never static AWS keys.
# ETL4_DB_AUTH=iam
# ETL4_READ_DSN=host=YOUR_EXPRESS_GATEWAY port=5432 dbname=etl4_core user=etl4_reader
# ETL4_ASSET_BACKEND=s3
# ETL4_AWS_REGION=ap-southeast-2
# ETL4_S3_BUCKET=YOUR_PRIVATE_BUCKET
# ETL4_S3_PREFIX=YOUR_VERIFIED_PREFIX
# ETL4_S3_ROOT_KEY=YOUR_REGISTERED_ROOT_KEY
# ETL4_ALLOWED_ORIGINS=https://YOUR_AMPLIFY_HOST
