# LEGACY: settings for the old Django prototype (backend-django-old/), copied
# to .env by hand (README.md, "Legacy"). Only needs the values that differ from
# settings.py's defaults - right now that's just the Postgres port, because
# docker-compose.yml publishes it on 5433 (5432 is a common clash with a
# Postgres already running locally). The FastAPI backend uses backend/.env.
POSTGRES_PORT=5433
